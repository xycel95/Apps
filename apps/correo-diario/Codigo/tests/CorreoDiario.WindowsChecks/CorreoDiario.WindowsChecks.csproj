<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CorreoDiario.Core/CorreoDiario.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../src/CorreoDiario.Windows/PdfRenderer.cs" Link="PdfRenderer.cs" />
    <Compile Include="../CorreoDiario.SafetyTests/BrowserAuthCheck.cs" Link="BrowserAuthCheck.cs" />
    <Compile Include="../CorreoDiario.SafetyTests/OwaMailboxFixture.cs" Link="OwaMailboxFixture.cs" />
    <Compile Include="../CorreoDiario.SafetyTests/OwaSearchContract.cs" Link="OwaSearchContract.cs" />
    <Compile Include="../CorreoDiario.SafetyTests/OwaAttachmentContract.cs" Link="OwaAttachmentContract.cs" />
  </ItemGroup>
  <Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
